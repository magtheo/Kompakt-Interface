<?xml version="1.0" encoding="utf-8"?>
<!-- T-046 SPIKE. updatePeriodMillis=0: no system-driven polling —
     updates are pushed by the app (spike: app open; real: sync windows,
     midnight, boot). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="220dp"
    android:minHeight="140dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_day"
    android:previewLayout="@layout/widget_day"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_day_description" />
